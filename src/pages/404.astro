---
// The site 404 (CHECKLIST G1; docs/brand/type-system.md role 16): Pearl Whisper, one Poppins headline with "404" in it,
// one serif sentence, one real swatch from the data, one button back. Served for every unknown path by Workers Static
// Assets (wrangler.jsonc not_found_handling "404-page"). Never indexed.
import Base from '../layouts/Base.astro';
import { SITE_COPY } from '../scripts/family/site-copy.ts';
import { PEARL_WHISPER } from '../config/tokens.ts';
const c = SITE_COPY.notFound;
---
<Base title={c.title} description={c.description} path="/404.html" preloadFonts={['/fonts/poppins-700-latin.woff2']} themeColor={PEARL_WHISPER}>
  <Fragment slot="head">
    <meta name="robots" content="noindex">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  </Fragment>
  <main class="nf">
    <span class="nf-sw" aria-hidden="true"></span>
    <h1 class="h404">{c.h1}</h1>
    <p class="nf-line">{c.line}</p>
    <a class="nf-btn" href="/">{c.button}</a>
  </main>
</Base>
<style is:global>
  html, body { margin: 0; background: var(--pearl-whisper); color: var(--urban-slate); }
  .nf { min-height: 100svh; box-sizing: border-box; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--s3);
    padding: var(--s3) calc(var(--inset) + env(safe-area-inset-right, 0px)) var(--s3) calc(var(--inset) + env(safe-area-inset-left, 0px)); }
  .nf-sw { display: block; width: 80px; height: 80px; border-radius: var(--radius-round); background: var(--shade-vivid-violets-03); }
  .h404 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-404); line-height: 1; letter-spacing: -0.015em; text-transform: none; text-wrap: balance; max-width: 16ch; }
  .nf-line { margin: 0; font-family: var(--font-text); font-weight: 400; font-size: var(--fs-prose); line-height: var(--lh-prose); font-variant-numeric: proportional-nums; max-width: var(--measure-prose); }
  .nf-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 var(--s3); box-sizing: border-box; background: var(--ember-luxe); color: var(--urban-slate);
    font-family: var(--font-ui); font-size: var(--fs-button); font-weight: 600; line-height: 1; text-decoration: none; transition: transform var(--dur-press) var(--ease-standard); }
  @media (hover: hover) { .nf-btn:hover { transform: translateY(-1px); } }
  .nf-btn:active { transform: scale(0.98); }
  .nf-btn:focus-visible { outline: 2px solid var(--ember-luxe); outline-offset: 2px; position: relative; }
  .nf-btn:focus-visible::before { content: ""; position: absolute; inset: -2px; border: 2px solid var(--urban-slate); pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .nf-btn { transition: none; } }
</style>
