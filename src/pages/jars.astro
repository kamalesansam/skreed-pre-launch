---
// /jars/ (docs/specs/redesign.md D1): the jars on a page of their own. Sam, 2026-11-09, asked which sign-up the
// redesigned site keeps: "Both", the two steps on the landing page, and the jars kept as their own page that the
// navbar's gift opens. So this is the current site's section 5 exactly as built (Signup.astro, signup.css and
// scripts/signup/, none of them edited; docs/specs/section-5-picture.md): the three follow columns and their links, the
// Followed ticks filling and draining the visitor's jar, the form behind PUBLIC_LEADS, the footer line. Around it only
// what the landing page gave it: the wordmark at the top left (SiteLogo, with its glitch) and, where the section index
// stood, "Back to main page" as the About page has it; both are data-home (scripts/shell/back-home.ts), so a visitor
// who came from the landing page goes Back to it, restored from the back-forward cache where they left it. The old
// landing's island is not here, so the section's ground is its own cream and nothing draws under it; its script reads a
// page without the island as the page it already knew without one. The page's title is its h1, hidden from the eye:
// the section's own headline is a second-level heading. The section's two faces are in the first view here, so both
// are preloaded. The gift in the landing page's index links here; the sitemap lists it.
import Base from '../layouts/Base.astro';
import '../styles/jars.css';
import RdHead from '../components/redesign/RdHead.astro';
import WordmarkSprite from '../components/shell/WordmarkSprite.astro';
import SiteLogo from '../components/shell/SiteLogo.astro';
import Signup from '../components/signup/Signup.astro';
import { RD_JARS } from '../config/redesign.ts';
import { SIGNUP_GROUND } from '../config/signup-ground.ts';
import { SITE_URL } from '../config/site.ts';
import { FAM_COPY } from '../scripts/family/copy.ts';
import { SITE_COPY } from '../scripts/family/site-copy.ts';

const path = '/jars/';
const url = new URL(path, SITE_URL).href;
const o = SITE_COPY.org;
// the page's place in the site as structured data: the Organization node every page shares, the page and its breadcrumb
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${SITE_URL}/#org`, name: o.name, url: `${SITE_URL}/`, email: o.email, logo: `${SITE_URL}/icon-512.png`,
      address: { '@type': 'PostalAddress', addressLocality: o.locality, addressRegion: o.region, addressCountry: o.country }, sameAs: [o.instagram] },
    { '@type': 'WebPage', url, name: RD_JARS.title, description: RD_JARS.description, inLanguage: 'en-IN', publisher: { '@id': `${SITE_URL}/#org` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: o.name, item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: RD_JARS.title, item: url } ] },
  ],
}).replace(/</g, '\\u003c');
---
<Base title={RD_JARS.title} description={RD_JARS.description} path={path} preloadFonts={['/fonts/inter-opsz-wght-latin.woff2', '/fonts/jost-wght-latin.woff2']} themeColor={SIGNUP_GROUND}>
  <RdHead slot="head-first" />
  <script slot="head" type="application/ld+json" is:inline set:html={ld}></script>
  <WordmarkSprite />
  <header class="rd-jars-top">
    <SiteLogo />
    <a class="rd-jars-home" href="/" data-home>{FAM_COPY.backHome}</a>
  </header>
  <main class="rd-jars" id="main">
    <h1 class="sr-only">{RD_JARS.title}</h1>
    <Signup />
  </main>
</Base>
