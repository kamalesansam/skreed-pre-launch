---
// /shades/<family>/: one static page per colour family (docs/specs/family-page.md). The ten paths come from
// docs/data/shades-240.json; data.ts fails the build on anything but 10 families of 24. FAMILY_3D (mode.ts) decides
// whether the 3D island is built at all; the default build is swatch grid mode.
import Base from '../../layouts/Base.astro';
import '../../styles/family.css';
import FamilyHeadFirst from '../../components/family/FamilyHeadFirst.astro';
import FamilyPage from '../../components/family/FamilyPage.astro';
import { FAMILIES, NEUTRAL_HEX, pageCss, type Family } from '../../scripts/family/data.ts';
import { FAM_COPY } from '../../scripts/family/copy.ts';
import { SITE_COPY } from '../../scripts/family/site-copy.ts';
import { SITE_URL } from '../../config/site.ts';
import { family3dMode, familyPagesOn } from '../../scripts/family/mode.ts';

// FAMILY_PAGES off (the production default until Reserve and the Wall exist, G21): no page is emitted at all
export function getStaticPaths() {
  if (!familyPagesOn()) return [];
  return FAMILIES.map((fam) => ({ params: { family: fam.slug }, props: { fam } }));
}
interface Props { fam: Family }
const { fam } = Astro.props;
const mode = family3dMode();
const title = FAM_COPY.title(fam.name);
const description = FAM_COPY.description(fam.name, fam.shades[0].name, fam.shades[23].name);
const url = new URL(`/shades/${fam.slug}/`, SITE_URL).href;
// G26 and the page's place in the site as structured data (a data block: not executed, so no CSP hash). The default
// OG image (G5) is a designed asset still to come; the text tags ship now.
const o = SITE_COPY.org;
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${SITE_URL}/#org`, name: o.name, url: `${SITE_URL}/`, email: o.email, logo: `${SITE_URL}/icon-512.png`,
      address: { '@type': 'PostalAddress', addressLocality: o.locality, addressRegion: o.region, addressCountry: o.country }, sameAs: [o.instagram] },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: o.name, item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: fam.name, item: url } ] },
  ],
}).replace(/</g, '\\u003c');
const has3d = mode !== 'off';
// The island is a separate component, imported only in 3D builds, so an off build carries none of its scripts. The
// condition must fold at build time (Astro bundles the scripts of every imported component, rendered or not), so it
// reads PUBLIC_FAMILY_3D, which Vite replaces statically; mode.ts checks the same variable and its guards.
const ON3D = import.meta.env.PUBLIC_FAMILY_3D === 'dev' || import.meta.env.PUBLIC_FAMILY_3D === 'on' || (import.meta.env.DEV && import.meta.env.PUBLIC_FAMILY_3D !== 'off');
const Island = ON3D ? (await import('../../components/family/Island3D.astro')).default : null;
// the stage's skeleton and poster, under the same folded test (an off build carries no poster file)
const Poster = ON3D ? (await import('../../components/family/Poster.astro')).default : null;
---
<Base
  title={title}
  description={description}
  path={`/shades/${fam.slug}/`}
  preloadFonts={['/fonts/poppins-700-latin.woff2', '/fonts/open-sans-400-600-latin.woff2']}
  themeColor={NEUTRAL_HEX[fam.neutral]}
>
  <FamilyHeadFirst slot="head-first" fam={fam} has3d={has3d} />
  <style slot="head" is:inline set:html={pageCss(fam)}></style>
  <Fragment slot="head">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content={o.name}>
    <meta property="og:locale" content="en_IN">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={url}>
    <meta name="twitter:card" content="summary">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <script type="application/ld+json" is:inline set:html={ld}></script>
  </Fragment>
  <FamilyPage fam={fam} has3d={has3d} supplier={mode === 'on'}>{Poster && <Poster slot="poster" slug={fam.slug} mode={mode === 'on' ? 'on' : 'dev'} />}</FamilyPage>
  {Island && <Island mode={mode === 'on' ? 'on' : 'dev'} />}
</Base>
