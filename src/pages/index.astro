---
// / : the hero (docs/specs/hero.md), then in the after-track slot section 3, the quiz (docs/specs/quiz.md), section 4,
// the entrance and the five scenes (docs/specs/section-4-flux.md), and section 5, the sign-up (docs/specs/section-5.md);
// dev and staging builds add the Tune panel.
import Base from '../layouts/Base.astro';
import '../styles/shell.css';
import Gate from '../components/shell/Gate.astro';
import WordmarkSprite from '../components/shell/WordmarkSprite.astro';
import Loader from '../components/shell/Loader.astro';
import SiteLogo from '../components/shell/SiteLogo.astro';
import SiteNav from '../components/shell/SiteNav.astro';
import HeroStage from '../components/hero/HeroStage.astro';
import HeroPoster from '../components/hero/HeroPoster.astro';
import HeroPosterPreload from '../components/hero/HeroPosterPreload.astro';
import Countdown from '../components/hero/Countdown.astro';
import ScrollCue from '../components/hero/ScrollCue.astro';
import Section2Layers from '../components/hero/Section2Layers.astro';
import FamilyLinks from '../components/family/FamilyLinks.astro';
import Quiz from '../components/quiz/Quiz.astro';
import Room from '../components/room/Room.astro';
import Signup from '../components/signup/Signup.astro';
import BackToTop from '../components/shell/BackToTop.astro';
import { COPY } from '../config/copy.ts';
import { NIGHT } from '../config/tokens.ts';
import { SITE_URL } from '../config/site.ts';
import { SITE_COPY } from '../scripts/family/site-copy.ts';
// The dev-only component is imported only when its flag is set, so production carries neither its markup nor its
// scripts and styles (Astro bundles the scripts of every imported component, rendered or not).
// the landing's place in the site as structured data: the Organization node the family and About pages share, and the site
const o = SITE_COPY.org;
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${SITE_URL}/#org`, name: o.name, url: `${SITE_URL}/`, email: o.email, logo: `${SITE_URL}/icon-512.png`,
      address: { '@type': 'PostalAddress', addressLocality: o.locality, addressRegion: o.region, addressCountry: o.country }, sameAs: [o.instagram] },
    { '@type': 'WebSite', '@id': `${SITE_URL}/#site`, url: `${SITE_URL}/`, name: o.name, description: COPY.page.description, inLanguage: 'en-IN', publisher: { '@id': `${SITE_URL}/#org` } },
  ],
}).replace(/</g, '\\u003c');
const Tune = import.meta.env.PUBLIC_TUNE === '1' ? (await import('../components/dev/Tune.astro')).default : null;
---
<Base title={COPY.page.title} description={COPY.page.description} path="/" preloadFonts={['/fonts/open-sans-400-600-latin.woff2', '/fonts/ibm-plex-mono-500-caps.woff2']} themeColor={NIGHT}>
  <Gate slot="head-first" />
  <HeroPosterPreload slot="head" />
  <script slot="head" type="application/ld+json" is:inline set:html={ld}></script>
  <HeroStage>
    <HeroPoster slot="poster" />
    <WordmarkSprite slot="sprite" />
    <Loader slot="loader" />
    <SiteLogo slot="logo" />
    <SiteNav slot="logo" />
    <Countdown slot="copy" />
    <ScrollCue slot="cue" part="cue" />
    <Section2Layers slot="riders" />
    <FamilyLinks slot="riders" />
    <BackToTop slot="riders" page="home" />
    <Quiz slot="after-track" />
    <Room slot="after-track" />
    <Signup slot="after-track" />
    {Tune && <Tune slot="dev" />}
    <ScrollCue slot="last" part="script" />
  </HeroStage>
</Base>
