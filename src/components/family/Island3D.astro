---
// The family page's 3D island entry (FAMILY_3D=dev or on; docs/specs/family-page.md 20, 21, 24). Imported by the route
// only in 3D builds, so an off build carries none of it. boot.ts is small: it waits for the load event and idle time,
// then imports the stage chunk (three.js and the Tough case) behind the page's grid fallback and under the loader. In a
// supplier build (on) the data block names the Tough's LOD1 file, so boot.ts starts its download with the chunk's; the
// case types' own models load on scroll (24 D2), so nothing of them is named here.
import manifest from '../../data/case-model.json';
interface Props { mode: 'dev' | 'on' }
const { mode } = Astro.props;
const data = mode === 'on' ? { mode, lod1: manifest.lod1 } : { mode };
---
<script type="application/json" id="fam-3d" is:inline set:html={JSON.stringify(data)}></script>
<script>import '../../scripts/family/three/boot.ts';</script>
