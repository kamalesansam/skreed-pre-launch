---
// The family page's 3D island entry (FAMILY_3D=dev or on; docs/specs/family-page.md 2.5, case-model-class.md 11).
// Imported by the route only in 3D builds, so an off build carries none of it. boot.ts is small: it waits for the load
// event and idle time, then imports the stage chunk (three.js, the case model) behind the page's grid fallback.
interface Props { mode: 'dev' | 'on' }
const { mode } = Astro.props;
---
<script type="application/json" id="fam-3d" is:inline set:html={JSON.stringify({ mode })}></script>
<script>import '../../scripts/family/three/boot.ts';</script>
