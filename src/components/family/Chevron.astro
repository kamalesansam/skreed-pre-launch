---
// The one static chevron of the Prev and Next buttons (spec 2.3). Not an animated arrow (rule 45).
interface Props { dir: 'left' | 'right' }
const { dir } = Astro.props;
---
<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d={dir === 'left' ? 'M10.5 2.5 5 8l5.5 5.5' : 'M5.5 2.5 11 8l-5.5 5.5'} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" /></svg>
