---
// The body of /shades/<family>/ (docs/specs/family-page.md 19 to 21). The stage is fixed behind the page; the page
// scrolls seven screens over it (the carousel, the zoom, the four case types, the argument screen). Chrome (round 3,
// Sam 2026-10-15): the wordmark top left with the hero's glitch (E-F4), "All families" top right as plain text, the
// family's name as the only words on the landing screen (D9), the bar with the selected shade's swatch and name, the
// arrows, the scrubber and the finish; no header bar, no Reserve, no "Show swatches" (D4, D7). The swatch grid is in
// the stage on every build, so swatch grid mode is right at first paint (2.7); CSS picks what shows from the head
// script's html.m3d, html.grid and data-why, before the page module runs.
import type { Family } from '../../scripts/family/data.ts';
import { FAMILIES, familyHref } from '../../scripts/family/data.ts';
import { ARGUMENT, BEATS, FAM_COPY, splitLine } from '../../scripts/family/copy.ts';
import SiteLogo from '../shell/SiteLogo.astro';
import Chevron from './Chevron.astro';
import SwatchGrid from './SwatchGrid.astro';
import FamilyCue from './FamilyCue.astro';
import manifest from '../../data/case-model.json';
import { size3dMb } from '../../scripts/family/size3d.ts';

interface Props { fam: Family; has3d: boolean; supplier?: boolean }
const { fam, has3d, supplier = false } = Astro.props;
const key = fam.key;
const ki = key.index - 1;
// size3d: the island plus both models' downloads in MB for "Show in 3D" (supplier builds); the stand-in has none to state
const size3d: string | null = has3d && supplier ? size3dMb(manifest.bytes, manifest.magtough?.bytes) : null;
const [mw, mh, md] = manifest.sizeMm;
const data = { slug: fam.slug, name: fam.name, first: fam.first, key: ki, has3d, size3d, names: fam.shades.map((s) => s.name), dims: { w: +(mw / mh).toFixed(4), d: +(md / mh).toFixed(4) } };
// the two state lines that are known before any script runs (spec 3, 5): data-why "savedata" or "slow" shows one
const whyLines = has3d ? ([['savedata', FAM_COPY.saveData], ['slow', FAM_COPY.slowConnection]] as const).map(([why, line]) => ({ why, part: splitLine(line) })) : [];
const show3d = size3d ? FAM_COPY.show3d(size3d) : FAM_COPY.show3dPlain;
// "</" never appears in names, but escape it anyway so the data block can never close its script element early
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<SiteLogo />
<button class="allfam ring2 press" type="button" id="famBtn" popovertarget="family-switcher">{FAM_COPY.allFamilies}</button>
<main id="main" class="fp">
  <section class="lineup" aria-labelledby="fam-title">
    <div class="fp-title"><h1 id="fam-title" translate="no">{fam.name}</h1></div>
    <div class="fade" aria-hidden="true"></div>
    <FamilyCue />
    <div class="fp-stage" id="stage">
      {has3d && <div class="st3d" id="st3d" role="img" aria-label={FAM_COPY.stage(fam.name, key.name)}><svg class="skel" id="skel" aria-hidden="true" focusable="false"></svg></div>}
      <div class="grid-slot" id="grid-slot"><SwatchGrid fam={fam} /></div>
    </div>
    <div class="below">
      <div class="fp-hud" id="hud">
        <button class="hud-btn prev ring2 press" type="button" id="prev" aria-label={FAM_COPY.prev} aria-disabled={ki === 0 ? 'true' : undefined}><Chevron dir="left" /></button>
        <button class="hud-btn next ring2 press" type="button" id="next" aria-label={FAM_COPY.next} aria-disabled={ki === 23 ? 'true' : undefined}><Chevron dir="right" /></button>
        <span class="sr" id="hudNumSr">{FAM_COPY.numberSr(key)}</span>
      </div>
      <div class="fp-state" id="state" role="status">{whyLines.map(({ why, part: [lead, rest] }) => <p data-line={why}><strong>{lead}</strong> {rest}<button type="button" class="ring2 press">{show3d}</button></p>)}</div>
      <div class="fp-scrub">
        <div class="scrub ring2" id="scrub" role="slider" tabindex="0" aria-label={FAM_COPY.scrubber} aria-orientation="horizontal" aria-valuemin="1" aria-valuemax="24" aria-valuenow={key.index} aria-valuetext={FAM_COPY.scrubberText(key)}>
          <span class="dots" aria-hidden="true">{fam.shades.map((s) => <i data-s={s.nnn}></i>)}</span>
          <span class="mark" aria-hidden="true"></span>
        </div>
      </div>
      <div class="fp-ctl">
        <div class="finish" id="finish" role="group" aria-label={FAM_COPY.finish}>
          <button type="button" class="ring2" data-finish="matte" aria-pressed="true">{FAM_COPY.matte}</button>
          <button type="button" class="ring2" data-finish="gloss" aria-pressed="false">{FAM_COPY.gloss}</button>
        </div>
      </div>
      <div class="bar" id="bar">
        <span class="bar-shade"><span class="bar-sw" aria-hidden="true"></span><span class="bar-name" id="barName" translate="no"><span>{key.name}</span></span></span>
      </div>
    </div>
  </section>
  <div id="tint" aria-hidden="true"></div>
  <div class="arg" id="arg" aria-hidden="true">
    <canvas class="smoke" id="smoke" width="96" height="54"></canvas>
    <div class="arg-box" id="arg-box">
      <svg class="arg-svg" id="arg-svg" viewBox="0 0 1314 405" focusable="false"><defs><clipPath id="arg-clip" clipPathUnits="userSpaceOnUse"></clipPath></defs></svg>
      <div class="arg-blur" id="arg-blur"></div>
    </div>
  </div>
  <div class="beats" id="beats">
    <section class="beat" data-beat="z" aria-hidden="true"><div class="beat-in"></div></section>
    {BEATS.map((b) => (
      <section class="beat" data-beat={b.id} id={`beat-${b.id}`} aria-labelledby={`b${b.id}-h`}><div class="beat-in"><div class="beat-txt">
        <h2 class="beat-h" id={`b${b.id}-h`}><span>{b.name}</span></h2>
        <p class="beat-p"><span>{b.copy}</span></p>
      </div></div></section>
    ))}
    <section class="beat" data-beat="arg" aria-labelledby="arg-h"><div class="beat-in"></div><h2 class="sr" id="arg-h">{ARGUMENT.heading}</h2></section>
  </div>
  <div class="beatnav" id="beatnav" role="group" aria-label={FAM_COPY.caseTypes}>
    {BEATS.map((b) => <button type="button" class="ring2" data-beat={b.id} aria-label={b.name}>{b.id}</button>)}
  </div>
</main>
<div id="family-switcher" class="sw" popover>
  <nav class="sw-in" aria-labelledby="sw-h">
    <div class="sw-head"><p class="sw-h" id="sw-h">{FAM_COPY.families}</p><button class="sw-close ring2 press" type="button" popovertarget="family-switcher" popovertargetaction="hide">{FAM_COPY.switcherClose}</button></div>
    <ol class="sw-list">
      {FAMILIES.map((g) => (
        <li><a class="ring2" href={familyHref(g)} aria-current={g.slug === fam.slug ? 'page' : undefined}><span class="sw-dot" data-s={g.key.nnn} aria-hidden="true"></span><span translate="no">{g.name}</span></a></li>
      ))}
    </ol>
  </nav>
</div>
<p class="sr" id="live" aria-live="polite"></p>
<script type="application/json" id="fam-data" is:inline set:html={json}></script>
<script>import '../../scripts/family/page.ts';</script>
