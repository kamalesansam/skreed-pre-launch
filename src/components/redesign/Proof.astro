---
// The three framed lines over a photograph on the redesigned landing page (docs/specs/redesign.md, the "proof" rows of
// sections 3 to 6; Sam, 2026-11-09: "checkout the pdf, and build the exact same thing" and "have that parallax effect
// or any other scroll effect forthe images"). The PDF's band: the woman in the white blazer under the PDF's flat black
// veil, and over her three frames in a 1.5 px rule, each an icon and one line about Skreed.
// The icons are our own drawings, written here as paths in a 96 by 96 box: a cup with a star, a line globe (the PDF's
// is a filled map) and a painter's palette. Every stroke is a <path>, so scripts/redesign/proof.ts can measure each
// one and draw it. A frame is four lines, one a side, each a border on an empty box, as the quiz's box is
// (QuizCta.astro), so the script can draw them and they land on the screen's pixels as the page's other rules do.
// No style attribute anywhere (the CSP): every place and size is a class in rd-proof.css.
import '../../styles/rd-proof.css';
import RdPicture from './RdPicture.astro';
import { RD_COPY } from '../../config/redesign.ts';
const c = RD_COPY.proof;

/** a circle as a path, so it has a length to draw like the rest */
const dot = (x: number, y: number, r: number) => `M${x - r} ${y}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0Z`;
/** a five-pointed star round (x, y): the outer points at R, the inner at r, the first point up */
const star = (x: number, y: number, R: number, r: number) => 'M' + Array.from({ length: 10 }, (_, i) => {
  const a = (-90 + i * 36) * Math.PI / 180, d = i % 2 ? r : R;
  return `${(x + d * Math.cos(a)).toFixed(2)} ${(y + d * Math.sin(a)).toFixed(2)}`;
}).join('L') + 'Z';

const ICONS: Record<(typeof c.items)[number]['icon'], readonly string[]> = {
  // the cup, its two handles, the star, the stem, the plinth and the base
  trophy: [
    'M26 4H70V37C70 49.2 60.2 59 48 59S26 49.2 26 37Z',
    'M26 10.5H6.5V24C6.5 35.5 15.5 44.5 27.7 45.6',
    'M70 10.5H89.5V24C89.5 35.5 80.5 44.5 68.3 45.6',
    star(48, 29, 15, 6.4),
    'M43.5 58.5V70',
    'M52.5 58.5V70',
    'M33 70H63V82H33Z',
    'M22 82H74V92.5H22Z',
  ],
  // the globe: its edge, the equator and two parallels seen from a little above, the middle meridian and two beside it
  globe: [
    dot(48, 48, 42),
    'M6 48Q48 58.5 90 48',
    'M11.6 27Q48 36 84.4 27',
    'M11.6 69Q48 78 84.4 69',
    'M48 6V90',
    'M48 6C25.5 19 25.5 77 48 90',
    'M48 6C70.5 19 70.5 77 48 90',
  ],
  // the palette: its edge with the thumb's cove at the lower right, and six dabs of paint
  palette: [
    'M45 4C68 4 90 20.5 90 42.5C90 53 83 61 73.5 60C67.5 59.4 61.8 61.6 60.2 66.8C58.6 72 62.8 77.6 62.4 83.4C62 88.8 56.6 92 49.2 92C24 92 4 72 4 47.5C4 23.2 22.4 4 45 4Z',
    dot(76.5, 41.5, 5.9),
    dot(66, 23, 5.9),
    dot(44.5, 17.5, 5.9),
    dot(25, 30.5, 5.9),
    dot(19, 53.5, 5.9),
    dot(33.5, 74.5, 5.9),
  ],
};
const SIDES = ['top', 'right', 'bottom', 'left'] as const;
---
<section class="rd-sec rd-band rd-proof" id="proof" data-tone="dark" data-band="proof" aria-label={c.aria}>
  <RdPicture class="rd-band-pic" name="proof" alt={c.alt} sizes="(max-width: 719px) 200vw, 100vw" />
  <div class="rd-wrap rd-proof-wrap">
    <ul class="rd-proof-list" role="list">
      {c.items.map((it) => (
        <li class="rd-proof-item" data-icon={it.icon}>
          {SIDES.map((s) => <span class="rd-proof-side" data-side={s} aria-hidden="true"></span>)}
          <svg class="rd-proof-icon" viewBox="0 0 96 96" aria-hidden="true" focusable="false">{ICONS[it.icon].map((d) => <path d={d} />)}</svg>
          <p class="rd-proof-text">{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<script>
  import '../../scripts/redesign/proof.ts';
</script>
