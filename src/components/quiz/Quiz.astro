---
// Section 3, the quiz (docs/specs/quiz.md), in the hero's after-track slot: plain text on section 2's fog (Sam,
// 2026-10-19), the intro, the ten questions (seven answers each), the seven results (all server-rendered, one shown) and
// the gift form. The markup is complete without JavaScript (the intro reads, the no-JS line links to the families);
// scripts/quiz/deck.ts, loaded once the section is within a screen, adds the questions, the scoring, the shade draw, the
// states and the decode (every element marked data-dc decodes in and out as section 2's labels do). Shade names,
// numbers and hexes are resolved here at build from the catalog (the lazy chunk carries ids only). No style attributes
// (the CSP has no style-src-attr): the swatches carry data-shade and deck.ts paints them through the CSSOM.
import { QUIZ_COPY as Q, QUIZ_PERSONAS, QUIZ_QUESTIONS, needsRing, needsRingNight, shadeHref } from '../../config/quiz.ts';
import { SHADES } from '../../config/shades.gen.ts';
import { QUIZ_PICTURES } from '../../config/quiz-pictures.ts';
import '../../styles/quiz.css';
// The visual questions' answer pictures (Sam, 2026-10-20; config/quiz-pictures.ts): AVIF and WebP at two widths from
// scripts/quiz/encode-pictures.mjs, in a git-ignored folder (the Envato licence does not allow the files to be shared and
// the repository is public). A key with no files renders no picture, so a checkout without them builds words only.
const picUrls = import.meta.glob<string>('../../assets/quiz/pics/*.{avif,webp}', { eager: true, query: '?url', import: 'default' });
const picIndex: Record<string, { width: number; height: number; widths: number[] }> =
  Object.values(import.meta.glob<{ default: Record<string, { width: number; height: number; widths: number[] }> }>('../../assets/quiz/pics/index.json', { eager: true }))[0]?.default ?? {};
const PIC_SIZES = '(min-width: 900px) and (min-height: 600px) min(30vw, 440px), (min-width: 640px) and (max-height: 599px) calc((100vw - 92px) * 0.4), calc(100vw - 32px)';   // the frame's width: the laptop's column, a sideways phone's left column (two insets and the gap are 92 px at 844; 300.8 px there, quiz.css), the width between an upright phone's gutters
const picture = (key: string) => {
  const m = picIndex[key];
  if (!m || !QUIZ_PICTURES.some((p) => p.key === key)) return null;
  const set = (ext: string) => m.widths.map((w) => { const u = picUrls[`../../assets/quiz/pics/${key}-${w}.${ext}`]; return u ? `${u} ${w}w` : ''; });
  const avif = set('avif'), webp = set('webp');
  if (avif.includes('') || webp.includes('')) return null;
  return { avif: avif.join(', '), webp: webp.join(', '), src: webp[0].split(' ')[0], width: m.width, height: m.height };
};
// The gift form needs its Worker (quiz.md D7): on in dev, test and staging builds, off in production until PUBLIC_LEADS
// is set to on (folded at build time; the gift email is saved for later, Sam 2026-10-19).
const LEADS = import.meta.env.PUBLIC_LEADS === 'on' || (import.meta.env.PUBLIC_LEADS !== 'off'
  && (import.meta.env.DEV || import.meta.env.PUBLIC_STAGING === '1' || import.meta.env.PUBLIC_HERO_HOOKS === '1'));
const byId = new Map(SHADES.map((s) => [s.id, s]));
const familyName = (f: string) => f.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ');
const shade = (id: string) => {
  const s = byId.get(id);
  if (!s) throw new Error(`quiz: ${id} is not a catalog shade`);
  return { ...s, fam: Q.fam(familyName(s.family), s.index), href: shadeHref(s.family, s.n), ring: needsRing(s.hex), night: needsRingNight(s.hex) };
};
---
<section class="quiz" id="find" aria-label={Q.aria} data-state="intro">
  <div class="qz-stage">
    <div class="qz-intro" id="qzIntro">
      <h2 class="qz-h" data-dc><span class="sr-only">{Q.h}</span><span aria-hidden="true">{Q.h}</span></h2>
      <p class="qz-sub" data-dc><span class="sr-only">{Q.sub}</span><span aria-hidden="true">{Q.sub}</span></p>
      <button type="button" class="qz-link qz-begin" id="qzBegin" data-label={Q.begin} data-loading={Q.loading} data-dc><span class="sr-only">{Q.begin}</span><span aria-hidden="true">{Q.begin}</span></button>
      {/* the way past the quiz (quiz-gate.md D3): section 4 is locked behind the quiz until the result or this press; split at build as Begin is, and hidden without JavaScript, where nothing is locked */}
      <button type="button" class="qz-link qz-skip" id="qzSkip" data-label={Q.skip} data-loading={Q.loading} data-dc><span class="sr-only">{Q.skip}</span><span aria-hidden="true">{Q.skip}</span></button>
      <noscript><p class="qz-noscript"><span class="sr-only">{Q.noscriptLead}</span><span aria-hidden="true">{Q.noscriptLead}</span><a href="/#families" aria-label={Q.noscriptLink}>{Q.noscriptLink}</a><span class="sr-only">{Q.noscriptTail}</span><span aria-hidden="true">{Q.noscriptTail}</span></p></noscript>
    </div>
    <div class="qz-deck" id="qzDeck" hidden>
      <div class="qz-cards" id="qzCards">
        {QUIZ_QUESTIONS.map((c, i) => (
          <div class="qz-card" data-i={i} data-visual={c.visual ? '' : undefined} data-pics={c.visual && c.answers.some((a) => picture(`q${i}-${a.persona}`)) ? '' : undefined} role="group" aria-label={Q.cardAria(i + 1)} tabindex="-1" hidden>
            <p class="qz-count" aria-hidden="true" data-dc>{Q.count(i + 1)}</p>
            <h3 class="qz-q" data-dc>{c.q}</h3>
            <div class="qz-opts">
              {c.answers.map((a) => (
                <button type="button" class="qz-opt" data-persona={a.persona} data-dc>{a.text}</button>
              ))}
            </div>
            <div class="qz-foot">
              {i > 0 && <button type="button" class="qz-link qz-back" data-dc>{Q.back}</button>}
              <button type="button" class="qz-link qz-skip" data-dc>{Q.skip}</button>
            </div>
            {c.visual && c.answers.some((a) => picture(`q${i}-${a.persona}`)) && (
              <div class="qz-pics" aria-hidden="true">
                {c.answers.map((a) => { const pic = picture(`q${i}-${a.persona}`); return pic && (
                  <picture class="qz-pic" data-persona={a.persona}>
                    <source type="image/avif" srcset={pic.avif} sizes={PIC_SIZES} />
                    <img src={pic.src} srcset={pic.webp} sizes={PIC_SIZES} width={pic.width} height={pic.height} alt="" loading="lazy" decoding="async" />
                  </picture>
                ); })}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
    <div class="qz-results" id="qzResults" hidden>
      {QUIZ_PERSONAS.map((p) => {
        const first = shade(p.shades[0]);
        return (
          <article class="qz-result" data-persona={p.id} data-finish={p.finish} hidden>
            <span class="qz-big" data-shade={first.id} data-ring={first.ring ? '' : undefined} data-ring-night={first.night ? '' : undefined} aria-hidden="true"></span>
            <div class="qz-rtext">
              <p class="qz-eyebrow" data-dc>{Q.eyebrow}</p>
              <h3 class="qz-shade" tabindex="-1" data-dc>{first.name}.</h3>
              <p class="qz-fam" data-dc>{first.fam}</p>
              <p class="qz-finish" data-dc>{Q.finish(p.finish)}</p>
              <p class="qz-persona" data-dc>{p.name}</p>
              <p class="qz-text" data-dc>{p.profile}</p>
              <p class="qz-palette" data-dc>{p.palette}</p>
              <p class="qz-also-h" data-dc>{Q.also}</p>
              <ul class="qz-also">
                {p.shades.map((id) => { const s = shade(id); return (
                  <li class="qz-mini" data-shade={s.id} data-family={s.family} data-name={s.name} data-fam={s.fam} data-href={s.href} data-ring={s.ring ? '' : undefined} data-ring-night={s.night ? '' : undefined} hidden={id === first.id}>
                    <span class="qz-mini-sw" data-shade={s.id} data-ring={s.ring ? '' : undefined} data-ring-night={s.night ? '' : undefined} aria-hidden="true"></span>
                    <span class="qz-mini-name" data-dc>{s.name}</span>
                  </li>
                ); })}
              </ul>
              <p class="qz-own" data-dc>{Q.own}</p>
              <div class="qz-actions">
                <a class="qz-link qz-see" href={first.href} data-dc>{Q.see}</a>
                <button type="button" class="qz-link qz-retry" data-dc>{Q.retry}</button>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <p class="sr-only" id="qzLive" aria-live="polite"></p>
  </div>
  {LEADS && <div class="qz-gift" id="qzGift" hidden>
    <div class="qz-gift-in">
      <h3 class="qz-gift-h" data-dc>{Q.gift}</h3>
      <p class="qz-gift-sub" data-dc>{Q.giftSub}</p>
      <form class="qz-form" id="qzForm" novalidate>
        <div class="qz-fields">
          <label class="qz-label" for="qzEmail" data-dc>{Q.email}</label>
          <input class="qz-input" id="qzEmail" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" required aria-describedby="qzErrEmail">
          <p class="qz-err" id="qzErrEmail"></p>
          <label class="qz-check"><input type="checkbox" id="qzConsent" name="consent" required aria-describedby="qzErrConsent"><span class="qz-tick" aria-hidden="true"></span><span data-dc>{Q.consent}</span></label>
          <p class="qz-err" id="qzErrConsent"></p>
          <button type="submit" class="qz-link" id="qzSend" data-dc>{Q.send}</button>
          <p class="qz-msg" id="qzMsg" role="status"></p>
          <p class="qz-fine" data-dc>{Q.fine}</p>
        </div>
        <div class="qz-done" id="qzDone" hidden>
          <p class="qz-done-text" tabindex="-1"></p>
          <button type="button" class="qz-link qz-notyou">{Q.notYou}</button>
        </div>
      </form>
    </div>
  </div>}
</section>
<script>
  // the loader: the chunk comes once the section is within a screen, or at once when "Click to begin" or "Skip quiz" is
  // pressed first. Any press on either before the chunk has mounted (whether or not the import is already in flight)
  // shows "Loading..." on that button and is replayed by mountQuiz through data-pending; a press on the other button
  // while one is pending does nothing; once mounted, deck.ts owns both.
  const root = document.getElementById('find');
  const begin = document.getElementById('qzBegin') as HTMLButtonElement | null, skip = document.getElementById('qzSkip') as HTMLButtonElement | null;
  if (root && begin && skip) {
    const buttons = [begin, skip];
    let p: Promise<unknown> | null = null, mounted = false, retry = '';
    // a label in two copies, as the server drew it: sentence case for assistive technology, capitals on screen
    const say = (b: HTMLButtonElement, t: string) => { const a = document.createElement('span'), c = document.createElement('span'); a.className = 'sr-only'; a.textContent = t; c.setAttribute('aria-hidden', 'true'); c.textContent = t; b.replaceChildren(a, c); };
    const pending = () => buttons.some((b) => b.dataset.pending);
    // a rejected import (a chunk gone after a redeploy, a dropped connection) gives the pending button its label back, so
    // the next press tries again; it also retries by itself when the connection returns. The browser's module map
    // remembers a failed fetch, so the retry goes through a fresh URL (the one the error names, with a query), where the browser gives one.
    const reset = (err: unknown) => { const m = /(https?:\/\/[^\s'"()]+\.js)/.exec(String((err as Error)?.message ?? err)); if (m) retry = m[1]; p = null; for (const b of buttons) { if (!b.dataset.pending) continue; b.removeAttribute('aria-disabled'); b.removeAttribute('aria-busy'); delete b.dataset.pending; say(b, b.dataset.label ?? ''); } };
    const load = (): Promise<typeof import('../../scripts/quiz/deck.ts')> => (retry ? import(/* @vite-ignore */ `${retry}?r=${Date.now()}`) : import('../../scripts/quiz/deck.ts'));
    const start = () => (p ??= load().then((m) => { m.mountQuiz(root); mounted = true; }).catch(reset));
    addEventListener('online', () => { if (!mounted && !p) void start(); });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); void start(); } }, { rootMargin: '100% 0px' });
      io.observe(root);
    } else void start();
    for (const b of buttons) b.addEventListener('click', () => {
      if (mounted || pending()) return;
      b.setAttribute('aria-disabled', 'true'); b.setAttribute('aria-busy', 'true'); say(b, b.dataset.loading ?? ''); b.dataset.pending = '1';
      void start();
    });
  }
</script>
