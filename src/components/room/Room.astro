---
// Section 4, the five scenes (docs/specs/section-4-flux.md 2, 3 and 5 "The DOM"; docs/specs/section-4-no-hall.md since
// 2026-11-02, when the hall's still, the prompt at its door and Skip left with it), in the hero's after-track slot after
// the quiz. On the 3D path a track of 6.8 screens with a sticky stage over the hero's canvas, which draws the third wipe
// from the fog straight to scene 1 and the carousel; the stage holds only what the section needs over it, all plain
// text on the scene in section 2's label type (Sam, 2026-10-20): the pad (the stage's focusable group, the section's
// first tab stop), the loading line, the five scenes as a list (each its poster still, its four lines with the scene
// hint above scene 1's count, the loading line and its alt), the previous and next words bottom right, the "Pause
// motion" control (hidden unless E-S4-loops is declined) and the live region. On the poster tier the scenes in a column
// from the section's top; without JavaScript the same from the noscript copy. scripts/room/walk.ts drives it (lazy,
// when the section nears). No style attributes (the CSP has no style-src-attr): positions are set through the CSSOM.
import { ROOM_COPY as R, ROOM_SCENES, SCENE_COUNT, SCENE_SIZE, fill, productById, shadeLine } from '../../config/room.ts';
import { QUIZ_GATE } from '../../config/quiz.ts';
import gate from '../../inline/room-gate.inline.js?raw';
import gateHooks from '../../inline/room-gate.hooks.inline.js?raw';
import { inlineScript } from '../shell/inlineScript.ts';
import '../../styles/room.css';

const N = SCENE_COUNT;
// The quiz gate (docs/specs/quiz-gate.md D1, D2; Sam, 2026-10-26): the section is rendered hidden and data-locked, so the
// page ends at the quiz until the result shows or Skip quiz is pressed (scripts/quiz/gate.ts opens it), and a visit that
// opened it already (the flag in sessionStorage) opens it again through the inline step right after the section, before
// anything below the quiz can paint; assembled as the head Gate's script is (inlineScript.ts, the key prepended), with
// the ?room=open override concatenated into test and staging builds only (PUBLIC_HERO_HOOKS '1'). scripts/csp.mjs
// hashes the emitted string after the build. Without JavaScript nothing is locked (room.css shows the section).
const hooks = import.meta.env.PUBLIC_HERO_HOOKS === '1';
const gateCode = inlineScript('room-gate.js', { KEY: QUIZ_GATE.key }, hooks ? gateHooks : '', gate);
const P = SCENE_SIZE.portrait, Wd = SCENE_SIZE.wide;
const scenes = ROOM_SCENES.map((s) => ({ ...s, name: productById(s.product).name, line: productById(s.product).line, shadeText: shadeLine(s), count: fill(R.count, { n: s.order, N }) }));
---
<section class="room" id="room" aria-label={R.aria} data-state="approach" hidden data-locked>
  <div class="rm-track">
    <div class="rm-stage" id="rmStage">
      <div class="rm-pad" id="rmPad" tabindex="0" role="group" aria-label={R.worldAria}></div>
      <button type="button" class="rm-pause rm-link" id="rmPause" hidden>{R.pause}</button>
      <p class="rm-line rm-loading" id="rmLoading" role="status" hidden>{R.loading}</p>
      <h2 class="sr-only">{R.scenesTitle}</h2>
      <ol class="rm-scenes" id="rmScenes" aria-label={R.scenesAria}>
        {scenes.map((s) => (
          <li class="rm-scene" data-id={s.id} data-i={s.i}>
            <picture class="rm-scene-pic" data-lazy>
              <source media="(orientation: portrait)" data-srcset={s.files.portrait.avif} type="image/avif" width={P.width} height={P.height} />
              <source media="(orientation: portrait)" data-srcset={s.files.portrait.webp} type="image/webp" width={P.width} height={P.height} />
              <source data-srcset={s.files.wide.avif} type="image/avif" />
              <img data-src={s.files.wide.webp} alt={s.alt} width={Wd.width} height={Wd.height} loading="lazy" decoding="async" />
            </picture>
            <div class="rm-scene-text">
              <h3 class="rm-scene-name" id={`rmName-${s.id}`} tabindex="-1">{s.name}</h3>
              <p class="rm-scene-shade">{s.shadeText}</p>
              <p class="rm-scene-line">{s.line}</p>
              {/* the scene hint, a row of scene 1's lines on its first visit, on both classes: above the count, whose row the
                  previous and next words share at 390 (a row under the count would cross them) */}
              {s.i === 0 && <p class="rm-scene-hint" id="rmSceneHint" hidden>{R.sceneHintTouch}</p>}
              <p class="rm-scene-count">{s.count}</p>
              <p class="rm-scene-more" aria-hidden="true" hidden></p>
            </div>
            <p class="sr-only rm-scene-alt" id={`rmAlt-${s.id}`}>{s.alt}</p>
          </li>
        ))}
      </ol>
      <div class="rm-nav" id="rmNav">
        <button type="button" class="rm-prev rm-link" id="rmPrev">{R.prev}</button>
        <button type="button" class="rm-next rm-link" id="rmNext">{R.next}</button>
      </div>
      <p class="sr-only" id="rmLive" aria-live="polite"></p>
      <noscript>
        <ol class="rm-scenes rm-scenes-static" aria-label={R.scenesAria}>
          {scenes.map((s) => (
            <li class="rm-scene">
              <picture class="rm-scene-pic">
                <source media="(orientation: portrait)" srcset={s.files.portrait.avif} type="image/avif" width={P.width} height={P.height} />
                <source media="(orientation: portrait)" srcset={s.files.portrait.webp} type="image/webp" width={P.width} height={P.height} />
                <source srcset={s.files.wide.avif} type="image/avif" />
                <img src={s.files.wide.webp} alt={s.alt} width={Wd.width} height={Wd.height} loading="lazy" decoding="async" />
              </picture>
              <div class="rm-scene-text"><h3 class="rm-scene-name">{s.name}</h3><p class="rm-scene-shade">{s.shadeText}</p><p class="rm-scene-line">{s.line}</p><p class="rm-scene-count">{s.count}</p></div>
            </li>
          ))}
        </ol>
      </noscript>
    </div>
  </div>
  <div class="rm-loopend" id="rmLoopEnd" aria-hidden="true"></div>
  <div class="rm-fade" id="rmFade" aria-hidden="true" hidden></div>
</section>
<script is:inline set:html={gateCode}></script>
<script>
  import { track } from '../../scripts/quiz/track.ts';
  // the walk script comes once the section is within a screen, or at once when the stage is focused or touched first
  const root = document.getElementById('room');
  if (root) {
    // the visit's unlock (quiz-gate.md D8): the inline step above opened the section from the visit's flag before this ran
    if (root.dataset.open === 'visit') track('room_unlock', { by: 'visit' });
    let p: Promise<unknown> | null = null;
    const start = () => (p ??= import('../../scripts/room/walk.ts').then((m) => m.mountRoom(root)));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); void start(); } }, { rootMargin: '100% 0px' });
      io.observe(root);
    } else void start();
    root.addEventListener('focusin', () => { void start(); }, { once: true });
    root.addEventListener('pointerdown', () => { void start(); }, { once: true });
  }
</script>
