---
// Section 4, the entrance and the Skreed universe (docs/specs/section-4.md 2 and 5), in the hero's after-track slot after
// the quiz. On the 3D path a track of 13 screens (15 once entered) with a sticky stage over the hero's canvas, which draws
// the hall, the transition and the universe; the stage holds the DOM the section needs: the prompt at the door (the
// section's first tabbable element, never hidden in the hall), the focusable pad that takes the walking keys, the skip,
// the universe's label panel and its products as real buttons (a roving tabindex), the hint and the loading line. On the
// poster tier and without JavaScript the two stills and the list stand in. scripts/room/walk.ts drives it (lazy, when the
// section nears). No style attributes (the CSP has no style-src-attr): positions are set through the CSSOM.
import { ROOM_COPY as R, ROOM_PRODUCTS } from '../../config/room.ts';
import '../../styles/room.css';

const products = ROOM_PRODUCTS;
// the poster tier's stills (scripts/room/render-stills.mjs renders them from our own build); absent files render nothing
const files = import.meta.glob<string>('../../assets/room/stills/*.{avif,webp}', { eager: true, query: '?url', import: 'default' });
const still = (name: string) => {
  const avif = files[`../../assets/room/stills/${name}.avif`], webp = files[`../../assets/room/stills/${name}.webp`];
  return avif && webp ? { avif, webp } : null;
};
const stills = (['hall', 'universe'] as const).map((which) => ({ which, portrait: still(`${which}-portrait`), wide: still(`${which}-wide`) })).filter((s) => s.portrait && s.wide);
---
<section class="room" id="room" aria-label={R.aria} data-state="hall">
  <div class="rm-track">
    <div class="rm-stage" id="rmStage">
      {/* the stills load only on the poster tier, when the section nears (walk.ts swaps data-srcset in), so the first view and
          the 3D path never fetch them; without JavaScript the noscript copy stands in */}
      {stills.map((s) => (
        <picture class="rm-still" data-which={s.which} data-lazy>
          <source media="(orientation: portrait)" data-srcset={s.portrait!.avif} type="image/avif" />
          <source media="(orientation: portrait)" data-srcset={s.portrait!.webp} type="image/webp" />
          <source data-srcset={s.wide!.avif} type="image/avif" />
          <img data-src={s.wide!.webp} alt={s.which === 'hall' ? R.stillHallAlt : R.stillRoomAlt} width="1280" height="800" decoding="async" />
        </picture>
      ))}
      <noscript>
        {stills.map((s) => (
          <picture class="rm-still" data-which={s.which}>
            <source media="(orientation: portrait)" srcset={s.portrait!.avif} type="image/avif" />
            <source media="(orientation: portrait)" srcset={s.portrait!.webp} type="image/webp" />
            <source srcset={s.wide!.avif} type="image/avif" />
            <img src={s.wide!.webp} alt={s.which === 'hall' ? R.stillHallAlt : R.stillRoomAlt} width="1280" height="800" loading="lazy" decoding="async" />
          </picture>
        ))}
      </noscript>
      <button type="button" class="btn rm-enter" id="rmEnter"><span class="rm-key" aria-hidden="true">{R.key}</span><span class="rm-enter-text">{R.enter}</span></button>
      <div class="rm-pad" id="rmPad" tabindex="0" aria-label={R.stageAria}></div>
      <div class="rm-skipwrap" id="rmSkipWrap" hidden><button type="button" class="txtbtn rm-skip" id="rmSkip">{R.skip}</button></div>
      <p class="rm-pill rm-label" id="rmLabel" data-touch={R.roomHintTouch} data-keys={R.roomHintKeys} hidden>{R.roomHintTouch}</p>
      <ol class="rm-products" id="rmProducts" aria-label={R.productsAria}>
        {products.map((p, i) => (
          <li class="rm-item" data-i={i} data-id={p.id}>
            <button type="button" class="rm-product" data-i={i} tabindex={i === 0 ? '0' : '-1'} aria-labelledby={`rmName-${p.id}`} aria-describedby={`rmLine-${p.id}`}>
              <span class="rm-name" id={`rmName-${p.id}`}>{p.name}</span>
              <span class="rm-line" id={`rmLine-${p.id}`} data-trim={p.line} data-catalog={p.lineCatalog}>{p.line}</span>
            </button>
          </li>
        ))}
      </ol>
      <p class="rm-pill rm-hint" id="rmHint" data-touch={R.hintTouch} data-keys={R.hintKeys} hidden>{R.hintTouch}</p>
      <p class="rm-pill rm-loading" id="rmLoading" role="status" hidden>{R.loading}</p>
      <p class="sr-only" id="rmLive" aria-live="polite"></p>
      <noscript><p class="rm-pill rm-noscript">{R.noscript}</p></noscript>
    </div>
  </div>
  <div class="rm-loopend" id="rmLoopEnd" aria-hidden="true"></div>
  <div class="rm-fade" id="rmFade" aria-hidden="true" hidden></div>
</section>
<script>
  // the walk script comes once the section is within a screen, or at once when the stage is focused or touched first
  const root = document.getElementById('room');
  if (root) {
    let p: Promise<unknown> | null = null;
    const start = () => (p ??= import('../../scripts/room/walk.ts').then((m) => m.mountRoom(root)));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); void start(); } }, { rootMargin: '100% 0px' });
      io.observe(root);
    } else void start();
    root.addEventListener('focusin', () => { void start(); }, { once: true });
    root.addEventListener('pointerdown', () => { void start(); }, { once: true });
  }
</script>
