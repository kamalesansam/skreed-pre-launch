---
// The section index (docs/specs/navbar.md; 2026-11-02: "we need to add a navbar, which is locked, so it's easier for ppl
// to navigate"), the landing page only: the four sections in page order, fixed at the top right on the logotype's row.
// From 768 px the four words in a row; on phones one word, Menu, opening a light drawer from the right, 75 percent of
// the screen ("make it come from the side, and just 75 % OF THE SCREEN from the side"), with the family switcher's
// layout (the popover attribute; Escape native, and a tap beside the panel closes it through site-nav.ts, which also keeps
// that tap from the page). The drawer sits inside the nav, so the index is one landmark. No fill, no box: the words on
// the scene as the logotype is (site-nav.css). Home is Back to top's jump, so
// the landing page draws no Back to top (BackToTop.astro). Plain fragment links, so the index works without JavaScript
// on the poster layout; with it, scripts/shell/site-nav.ts jumps in place under the --night veil and marks the section
// on screen. Products is always listed ("its okay add products as well no problem"): pressed while the quiz gate holds
// section 4, it opens it as Skip quiz does, with the gate's key from config/quiz.ts (data-gate-key, read at build time
// so the quiz's config stays out of the index's chunk). In the logo slot, after the logotype: a flat child of body
// after the loader, and next in the tab order.
import { COPY } from '../../config/copy.ts';
import { QUIZ_GATE } from '../../config/quiz.ts';
import { SECTION_IDS, type SectionId } from '../../scripts/shell/nav-map.ts';
import '../../styles/site-nav.css';

const N = COPY.nav;
const HREF: Record<SectionId, string> = { top: '#top', families: '#families', quiz: '#find', room: '#room' };
const items = SECTION_IDS.map((id) => ({ id, href: HREF[id], label: N.items[id] }));
---
<nav class="snav" id="siteNav" aria-label={N.aria} data-gate-key={QUIZ_GATE.key}>
  <ol class="snav-list">
    {items.map((s) => <li><a class="snav-a" href={s.href} data-sec={s.id}>{s.label}</a></li>)}
  </ol>
  <button class="snav-a snav-menu" type="button" popovertarget="site-sections">{N.menu}</button>
  <div id="site-sections" class="snav-sheet" popover>
    <div class="snav-in">
      <div class="snav-head"><p class="snav-h">{N.aria}</p><button class="snav-a snav-close" type="button" popovertarget="site-sections" popovertargetaction="hide">{N.close}</button></div>
      <ol class="snav-rows">
        {items.map((s) => <li><a href={s.href} data-sec={s.id}><span>{s.label}</span></a></li>)}
      </ol>
    </div>
  </div>
</nav>
<script>
  import '../../scripts/shell/site-nav.ts';
</script>
