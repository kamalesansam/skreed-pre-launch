---
// The loader (exception E-H1): shown only on html.hero3d. POSE, WT and the copy it needs are prepended as JSON from
// config/hero.ts, config/loader-weights.json and config/copy.ts, so the loader and the island can never drift.
import loader from '../../inline/loader.inline.js?raw';
import { POSE } from '../../config/hero.ts';
import { COPY } from '../../config/copy.ts';
import WT from '../../config/loader-weights.json';
import { inlineScript } from './inlineScript.ts';
const code = inlineScript('loader.js', { POSE, WT, COPY: { offline: COPY.ld.offline } }, loader);
---
<div class="intro" id="intro" role="progressbar" aria-label={COPY.ld.aria} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="ld-w"><div class="ld-m" id="ldM"><div class="ld-g" id="ldG"><i id="ldBase"></i><i id="ldFill"></i></div><div class="ld-s" id="ldS"><i id="ldBand"></i></div></div><svg class="ld-line" id="ldLine" viewBox="0 0 1209.46 292.9" aria-hidden="true" focusable="false"><use href="#skreed-wordmark"/></svg></div><p class="ld-p"><span id="ldSt" aria-live="polite"></span><span id="ldPct"><span id="ldN">0</span>%</span></p></div>
<script is:inline set:html={code}></script>
